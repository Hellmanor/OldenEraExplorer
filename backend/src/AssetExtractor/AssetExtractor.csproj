<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>AssetExtractor</RootNamespace>
  </PropertyGroup>

  <!-- Exclude vendored AssetRipper source from compilation (referenced as separate projects) -->
  <ItemGroup>
    <Compile Remove="AssetRipper/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- AssetRipper Project References (vendored code) -->
    <ProjectReference Include="AssetRipper/Source/AssetRipper.Assets/AssetRipper.Assets.csproj" />
    <ProjectReference Include="AssetRipper/Source/AssetRipper.IO.Files/AssetRipper.IO.Files.csproj" />
    <ProjectReference Include="AssetRipper/Source/AssetRipper.Numerics/AssetRipper.Numerics.csproj" />
    <ProjectReference Include="AssetRipper/Source/AssetRipper.SerializationLogic/AssetRipper.SerializationLogic.csproj" />
    <ProjectReference Include="AssetRipper/Source/AssetRipper.SourceGenerated.Extensions/AssetRipper.SourceGenerated.Extensions.csproj" />
    <ProjectReference Include="AssetRipper/Source/AssetRipper.Import/AssetRipper.Import.csproj" />
    <ProjectReference Include="AssetRipper/Source/AssetRipper.Processing/AssetRipper.Processing.csproj" />
    <ProjectReference Include="AssetRipper/Source/AssetRipper.Export.Modules.Textures/AssetRipper.Export.Modules.Textures.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- AssetRipper NuGet Packages (publicly available) -->
    <PackageReference Include="AssetRipper.SourceGenerated" Version="1.3.9" />
    <PackageReference Include="AssetRipper.Primitives" Version="3.2.0" />
    <PackageReference Include="AssetRipper.Checksum" Version="1.1.0" />
    <PackageReference Include="AssetRipper.Tpk" Version="1.1.0" />
    <PackageReference Include="AssetRipper.TextureDecoder" Version="2.5.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Other dependencies -->
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.1" />
    <PackageReference Include="BCnEncoder.Net" Version="2.2.1" />
    <PackageReference Include="SharpGLTF.Toolkit" Version="1.0.5" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="classdata.tpk" />
  </ItemGroup>

</Project>
